{
  "mcp_servers": {
    "video": {
      "command": "node",
      "args": ["${userHome}/.hermes/skills/video-studio/mcp-server.mjs"],
      "cwd": "${userHome}/.hermes/skills/video-studio",
      "env": {
        "VIDEO_STUDIO_DIR": "${workspace}/studio",
        "LLM_BASE_URL": "${LLM_BASE_URL}",
        "LLM_KEY": "${LLM_KEY}",
        "LLM_MODEL": "${LLM_MODEL}",
        "OPENAI_BASE_URL": "${OPENAI_BASE_URL}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "PEXELS_API_KEY": "${PEXELS_API_KEY}",
        "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
        "RENDER_CONCURRENCY": "2"
      },
      "timeout": 900,
      "connect_timeout": 60,
      "tools": {
        "include": [
          "transcribe",
          "analyze_highlights",
          "cut_clip",
          "face_crop",
          "generate_image",
          "search_stock",
          "render_reel",
          "send_video",
          "job_status"
        ]
      }
    }
  }
}
